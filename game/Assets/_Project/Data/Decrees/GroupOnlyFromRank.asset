    nominative: "\u0417\u0430\u0434\u0430\u043D\u0438\u044F \u043E\u0442 \u0440\u0430\u043D\u0433\u0430 C \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0440\u0443\u043F\u043F\u043E\u0439"
    genitive: "\u0417\u0430\u0434\u0430\u043D\u0438\u0439 \u043E\u0442 \u0440\u0430\u043D\u0433\u0430 C \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0440\u0443\u043F\u043F\u043E\u0439"
