  id: LootDispute
  displayName: "\u0421\u0441\u043E\u0440\u0430 \u0438\u0437-\u0437\u0430 \u0434\u043E\u0431\u044B\u0447\u0438"
  number: 3
  source: 0
  trigger: 3
  cooldownDays: 0
  cooldownPerGuild: 0
  oncePerPair: 0
  bodyTemplate: "{\u0438\u043C\u044F} \u0438 {\u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A} \u043D\u0435 \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438 \u0434\u043E\u0431\u044B\u0447\u0443 \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0443 {\u043C\u0435\u0441\u0442\u043E:\u0440}. \u041E\u0431\u0430 \u043F\u0440\u0438\u0448\u043B\u0438 \u043A \u0432\u0430\u043C."
  reasons: []
  arrivalEffects: []
  options:
  - text: "\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C {\u0438\u043C\u044F:\u0432}"
    visibleConsequencesText: "\u0414\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E {\u0438\u043C\u044F:\u0440} \u0440\u0430\u0441\u0442\u0451\u0442, {\u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A:\u0440} \u2014 \u043F\u0430\u0434\u0430\u0435\u0442; \u043E\u043D\u0438 \u043F\u043E\u0441\u0441\u043E\u0440\u044F\u0442\u0441\u044F"
    effects:
    - kind: 1
      target: 0
      value: 5
      flag: 0
      axis: 0
      pole: 0
      trait: {fileID: 0}
    - kind: 1
      target: 1
