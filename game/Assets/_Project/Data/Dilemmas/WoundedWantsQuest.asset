  - text: "\u0417\u0430\u043F\u0440\u0435\u0442\u0438\u0442\u044C"
    visibleConsequencesText: "\u0414\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E {\u0438\u043C\u044F:\u0440} \u043F\u0430\u0434\u0430\u0435\u0442"
