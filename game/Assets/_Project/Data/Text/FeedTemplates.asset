      pole: 0
      trait: {fileID: 0}
      stat: 0
    variants:
    - "{\u0438\u043C\u044F} \u0443\u0448[\u0451\u043B|\u043B\u0430] \u043E\u0434[\u0438\u043D|\u043D\u0430]. \u0421\u043A\u0430\u0437\u0430\u043B[|\u0430]@\u0438\u043C\u044F, \u0447\u0442\u043E \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
  - key: quest.travel
    feed: 0
    importance: 0
    conditions: []
    variants:
    - "\u041A \u0432\u0435\u0447\u0435\u0440\u0443 {\u0433\u0440\u0443\u043F\u043F\u0430} \u0434\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C \u0434\u043E {\u043C\u0435\u0441\u0442\u043E:\u0440}. \u0420\u0430\u0437\u0431\u0438\u043B\u0438 \u043B\u0430\u0433\u0435\u0440\u044C"
    - "\u0428\u043B\u0438 \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C. \u041C\u043E\u043B\u0447\u0430\u043B\u0438"
    - "\u0414\u043E\u0440\u043E\u0433\u0443 \u0440\u0430\u0437\u0432\u0435\u0437\u043B\u043E \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0436\u0434\u044F. \u0418\u0434\u0443\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    - "{\u0438\u043C\u044F} \u043D\u0430\u0448[\u0451\u043B|\u043B\u0430] \u0431\u0440\u043E\u0434. \u0421\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043B\u0438 \u043F\u043E\u043B\u0434\u043D\u044F"
