      trait: {fileID: 0}
      stat: 0
    variants:
    - "{\u0433\u0440\u0443\u043F\u043F\u0430} \u0432\u044B\u0448\u043B\u0430 \u0438\u0437 \u0432\u043E\u0440\u043E\u0442 \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435"
    - "{\u0433\u0440\u0443\u043F\u043F\u0430} \u0443\u0448\u043B\u0430 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 {\u043C\u0435\u0441\u0442\u043E:\u0440}. \u041F\u0440\u043E\u0432\u043E\u0436\u0430\u0442\u044C \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u044B\u0448\u0435\u043B"
    - "{\u0438\u043C\u044F} \u043F\u043E\u0441\u043B\u0435\u0434\u043D[\u0438\u043C|\u0435\u0439] \u0437\u0430\u0442\u044F\u043D\u0443\u043B[|\u0430] \u0440\u0435\u043C\u043D\u0438, \u0438 \u0433\u0440\u0443\u043F\u043F\u0430 \u0442\u0440\u043E\u043D\u0443\u043B\u0430\u0441\u044C"
