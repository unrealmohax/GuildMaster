  m_Script: {fileID: 11500000, guid: 5f2bb1b237dc2aa4f93932c2e9a120f7, type: 3}
  m_Name: LoanRequest
  m_EditorClassIdentifier: GuildMaster.Data::GuildMaster.Data.DilemmaDefinition
  id: LoanRequest
  displayName: "\u041F\u0440\u043E\u0441\u044C\u0431\u0430 \u0432 \u0434\u043E\u043B\u0433"
  number: 1
  source: 0
  trigger: 1
  cooldownDays: 0
  cooldownPerGuild: 0
  oncePerPair: 0
  bodyTemplate: "{\u0438\u043C\u044F} \u043F\u0440\u043E\u0441\u0438\u0442 \u0432 \u0434\u043E\u043B\u0433 {\u0441\u0443\u043C\u043C\u0430}. {\u043F\u0440\u0438\u0447\u0438\u043D\u0430}"
  reasons:
  - text: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u043D\u0435\u0447\u0435\u043C \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430 \u0436\u0438\u043B\u044C\u0451."
    requiresTrait: {fileID: 0}
  - text: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u043D\u0430 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435."
    requiresTrait: {fileID: 0}
  - text: "\u041E\u0431\u0435\u0449\u0430\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0441 \u043F\u0435\u0440\u0432\u043E\u0439 \u0436\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u044B."
    requiresTrait: {fileID: 0}
  - text: "\u0414\u043E\u043C\u0430 \u0436\u0434\u0443\u0442, \u0430 \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043D\u0435\u0447\u0435\u043C."
    requiresTrait: {fileID: 11400000, guid: 8c164c525bc952944bfe956b9287053a, type: 2}
  arrivalEffects:
  - kind: 10
    target: 0
    value: 0
    flag: 0
    axis: 0
    pole: 0
    trait: {fileID: 11400000, guid: 8c164c525bc952944bfe956b9287053a, type: 2}
  options:
  - text: "\u0414\u0430\u0442\u044C \u0432\u0441\u044E \u0441\u0443\u043C\u043C\u0443"
    visibleConsequencesText: "\u2212{\u0441\u0443\u043C\u043C\u0430} \u0438\u0437 \u043A\u0430\u0437\u043D\u044B, \u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E \u0438 \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u044C {\u0438\u043C\u044F:\u0440} \u0440\u0430\u0441\u0442\u0443\u0442"
