      trait: {fileID: 0}
    isRefusal: 0
    playerSelectable: 1
    answerFeedKey: dilemma.deserter.forgive
  - text: "\u041D\u0430\u043A\u0430\u0437\u0430\u0442\u044C \u0448\u0442\u0440\u0430\u0444\u043E\u043C"
    visibleConsequencesText: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0430 {\u0438\u043C\u044F:\u0440} \u2014 \u0432 \u043A\u0430\u0437\u043D\u0443, \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u0430\u0434\u0430\u0435\u0442; {\u0438\u043C\u044F} \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F"
