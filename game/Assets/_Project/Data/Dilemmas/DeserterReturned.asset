  m_Name: DeserterReturned
  m_EditorClassIdentifier: GuildMaster.Data::GuildMaster.Data.DilemmaDefinition
  id: DeserterReturned
  displayName: "\u0411\u0435\u0433\u043B\u0435\u0446 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F"
  number: 2
  source: 0
  trigger: 2
  cooldownDays: 0
  cooldownPerGuild: 0
  oncePerPair: 0
  bodyTemplate: "{\u0438\u043C\u044F} \u0432\u0435\u0440\u043D\u0443\u043B[\u0441\u044F|\u0430\u0441\u044C]. \u0421\u0442\u043E\u0438\u0442 \u0443 \u0434\u0432\u0435\u0440\u0435\u0439, \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0433\u043B\u0430\u0437. \u041F\u0440\u043E\u0441\u0438\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C [\u0435\u0433\u043E|\u0435\u0451]@\u0438\u043C\u044F \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u0438."
  reasons: []
  arrivalEffects: []
  options:
  - text: "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u044C"
    visibleConsequencesText: "{\u0438\u043C\u044F} \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F; \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0435 \u043D\u0430 \u0437\u0430\u0434\u0430\u043D\u0438\u0438 \u0431\u0443\u0434\u0443\u0442 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F \u043A [\u043D\u0435\u043C\u0443|\u043D\u0435\u0439]@\u0438\u043C\u044F \u0445\u0443\u0436\u0435"
