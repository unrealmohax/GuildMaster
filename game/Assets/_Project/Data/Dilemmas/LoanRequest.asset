    visibleConsequencesText: "\u2212{\u0441\u0443\u043C\u043C\u0430} \u0438\u0437 \u043A\u0430\u0437\u043D\u044B, \u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E {\u0438\u043C\u044F:\u0440} \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0441\u0442\u0451\u0442"
