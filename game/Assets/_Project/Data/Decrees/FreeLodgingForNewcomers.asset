  id: FreeLodgingForNewcomers
  displayName: "\u0415\u0434\u0430 \u0438 \u0436\u0438\u043B\u044C\u0451 \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432"
  lawNumber: 2
  nameForms:
    nominative: "\u0415\u0434\u0430 \u0438 \u0436\u0438\u043B\u044C\u0451 \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432"
    genitive: "\u0415\u0434\u044B \u0438 \u0436\u0438\u043B\u044C\u044F \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432"
    dative: "\u0415\u0434\u0435 \u0438 \u0436\u0438\u043B\u044C\u044E \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432"
    accusative: "\u0415\u0434\u0443 \u0438 \u0436\u0438\u043B\u044C\u0451 \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432"
    instrumental: "\u0415\u0434\u043E\u0439 \u0438 \u0436\u0438\u043B\u044C\u0451\u043C \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432"
    prepositional: "\u0415\u0434\u0435 \u0438 \u0436\u0438\u043B\u044C\u0435 \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432"
    gender: 4
  description: "\u0413\u0438\u043B\u044C\u0434\u0438\u044F \u043F\u043B\u0430\u0442\u0438\u0442 \u0437\u0430 \u0435\u0434\u0443 \u0438 \u0436\u0438\u043B\u044C\u0451 \u0442\u0435\u0445, \u043A\u0442\u043E \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u043D\u0435\u0434\u0430\u0432\u043D\u043E."
  plusText: "\u041F\u0440\u0438\u0442\u043E\u043A \u043B\u044E\u0434\u0435\u0439 \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0439"
  minusText: "\u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B, \u0445\u0430\u043B\u044F\u0432\u0449\u0438\u043A\u0438"
