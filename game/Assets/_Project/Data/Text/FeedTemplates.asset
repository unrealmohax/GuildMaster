    feed: 0
    importance: 0
    conditions: []
    variants:
    - "\u0413\u0440\u0443\u0437 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D. \u0417\u0430\u043A\u0430\u0437\u0447\u0438\u043A \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B \u043C\u0435\u0448\u043A\u0438 \u0438 \u043A\u0438\u0432\u043D\u0443\u043B"
    - "{\u0438\u043C\u044F} \u043E\u0442\u0434\u0430\u043B[|\u0430] \u043F\u0438\u0441\u044C\u043C\u043E \u0432 \u0440\u0443\u043A\u0438. \u041E\u0442\u0432\u0435\u0442\u0430 \u0436\u0434\u0430\u0442\u044C \u043D\u0435 \u0441\u0442\u0430\u043B\u0438"
    - "\u0423\u0441\u043F\u0435\u043B\u0438 \u0434\u043E \u0441\u0440\u043E\u043A\u0430"
