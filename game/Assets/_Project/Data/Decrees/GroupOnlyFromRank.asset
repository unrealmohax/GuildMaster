  minusText: "\u041E\u0434\u0438\u043D\u043E\u0447\u043A\u0438 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0439"
