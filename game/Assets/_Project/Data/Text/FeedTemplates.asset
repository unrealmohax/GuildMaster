    feed: 0
    importance: 0
    conditions: []
    variants:
    - "{\u0438\u043C\u044F} \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B[|\u0430] \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0443 \u043E \u043F\u0435\u0449\u0435\u0440\u0435. \u041F\u043E\u043B\u0443\u0447\u0438\u043B[|\u0430]@\u0438\u043C\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u043D\u0435\u0442"
