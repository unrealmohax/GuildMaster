    isRefusal: 1
    playerSelectable: 1
    answerFeedKey: dilemma.wounded.forbid
  - text: "\u041E\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u0438 \u0434\u0430\u0442\u044C \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044E"
    visibleConsequencesText: "\u2212{\u0441\u0443\u043C\u043C\u0430} \u0438\u0437 \u043A\u0430\u0437\u043D\u044B, \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E {\u0438\u043C\u044F:\u0440} \u0440\u0430\u0441\u0442\u0443\u0442"
