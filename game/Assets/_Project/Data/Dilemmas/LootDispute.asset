    answerFeedKey: dilemma.loot.partner
  - text: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u043F\u043E\u0440\u043E\u0432\u043D\u0443, \u0434\u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438\u0437 \u043A\u0430\u0437\u043D\u044B"
    visibleConsequencesText: "\u2212{\u0441\u0443\u043C\u043C\u0430} \u0438\u0437 \u043A\u0430\u0437\u043D\u044B, \u043E\u0431\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B"
