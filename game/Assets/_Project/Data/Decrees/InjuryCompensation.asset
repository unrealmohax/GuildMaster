  id: InjuryCompensation
  displayName: "\u041A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u044F \u0437\u0430 \u0440\u0430\u043D\u0435\u043D\u0438\u0435"
  lawNumber: 11
  nameForms:
    nominative: "\u041A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u044F \u0437\u0430 \u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    genitive: "\u041A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438 \u0437\u0430 \u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    dative: "\u041A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438 \u0437\u0430 \u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    accusative: "\u041A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u044E \u0437\u0430 \u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    instrumental: "\u041A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0435\u0439 \u0437\u0430 \u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    prepositional: "\u041A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438 \u0437\u0430 \u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    gender: 2
  description: "\u0417\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0440\u0430\u043D\u0443 \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u043F\u043B\u0430\u0442\u0438\u0442 \u0440\u0430\u043D\u0435\u043D\u043E\u043C\u0443: \u0437\u0430 \u043B\u0451\u0433\u043A\u0443\u044E, \u0442\u044F\u0436\u0451\u043B\u0443\u044E \u0438 \u0443\u0432\u0435\u0447\u044C\u0435 \u2014 \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443."
  plusText: "\u041B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u044C, \u043E\u0445\u043E\u0442\u043D\u0435\u0435 \u0440\u0438\u0441\u043A\u0443\u044E\u0442"
  minusText: "\u0420\u0430\u0441\u0445\u043E\u0434\u044B"
