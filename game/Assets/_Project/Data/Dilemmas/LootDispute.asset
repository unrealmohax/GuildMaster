    - kind: 9
      target: 0
      value: 0
      flag: 0
      axis: 1
      pole: 1
      trait: {fileID: 0}
    isRefusal: 0
    playerSelectable: 1
    answerFeedKey: dilemma.loot.subject
  - text: "\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C {\u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A:\u0432}"
    visibleConsequencesText: "\u0414\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E {\u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A:\u0440} \u0440\u0430\u0441\u0442\u0451\u0442, {\u0438\u043C\u044F:\u0440} \u2014 \u043F\u0430\u0434\u0430\u0435\u0442; \u0443\u0442\u0430\u0435\u043D\u043D\u043E\u0435 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F \u0432 \u043E\u0431\u0449\u0438\u0439 \u0434\u0435\u043B\u0451\u0436"
    effects:
