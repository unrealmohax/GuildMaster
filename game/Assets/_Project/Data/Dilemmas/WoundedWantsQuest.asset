  id: WoundedWantsQuest
  displayName: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u0440\u0432\u0451\u0442\u0441\u044F \u043D\u0430 \u0437\u0430\u0434\u0430\u043D\u0438\u0435"
  number: 4
  source: 0
  trigger: 4
  cooldownDays: 0
  cooldownPerGuild: 0
  oncePerPair: 0
  bodyTemplate: "{\u0438\u043C\u044F} \u0435\u0449\u0451 \u043D\u0435 \u043E\u043F\u0440\u0430\u0432\u0438\u043B[\u0441\u044F|\u0430\u0441\u044C] \u043E\u0442 \u0440\u0430\u043D\u044B, \u043D\u043E \u043F\u0440\u043E\u0441\u0438\u0442 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C [\u0435\u0433\u043E|\u0435\u0451] \u043D\u0430 \u0437\u0430\u0434\u0430\u043D\u0438\u0435. \u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u044B \u0441\u0435\u0439\u0447\u0430\u0441."
  reasons: []
  arrivalEffects: []
  options:
  - text: "\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C"
    visibleConsequencesText: "{\u0438\u043C\u044F} \u0441\u043C\u043E\u0436\u0435\u0442 \u0431\u0440\u0430\u0442\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0441 \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u0440\u0430\u043D\u043E\u0439, \u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E \u0440\u0430\u0441\u0442\u0451\u0442"
