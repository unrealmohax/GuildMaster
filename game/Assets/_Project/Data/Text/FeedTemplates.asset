    feed: 0
    importance: 1
    conditions: []
    variants:
    - "\u0417\u0432\u0435\u0440\u044C \u0443\u0448\u0451\u043B \u043F\u043E \u0440\u0443\u0447\u044C\u044E. \u0421\u043B\u0435\u0434 \u043F\u043E\u0442\u0435\u0440\u044F\u043D, \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0438\u0441\u043A\u0430\u0442\u044C \u0441\u043D\u043E\u0432\u0430"
